@using Projet_mvc.Models.Home

@model HomePageViewModel
@{
    ViewData["Title"] = "Accueil";
}

<div class="container mt-4">

    <div class="text-center mb-5 p-5 bg-white rounded shadow-sm border border-light-subtle">
        <h1 class="display-4 fw-bold">Bienvenue sur RetroSwap !</h1>
        <p class="lead text-secondary">Votre nouvelle destination pour acheter et vendre des trésors du jeu vidéo rétro entre passionnés.</p>
        <p class="text-muted">Redécouvrez les consoles et les jeux qui ont marqué votre enfance. Prêt à chiner ?</p>
        <hr class="my-4 w-50 mx-auto">
    </div>

    <!-- Tags populaires -->
    @if (Model.PopularTags != null && Model.PopularTags.Any())
    {
        <section class="mb-5 py-4 bg-light rounded shadow-sm">
            <h2 class="text-center mb-3 text-secondary">Tags populaires</h2>
            <div class="d-flex flex-wrap justify-content-center gap-2 px-3">
                @foreach (var tag in Model.PopularTags)
                {
                    <a asp-controller="Listings" asp-action="Index" asp-route-SelectedTagIds="@tag.Id" class="btn btn-outline-primary btn-sm rounded-pill">
                        #@tag.Label
                    </a>
                }
            </div>
        </section>
    }

