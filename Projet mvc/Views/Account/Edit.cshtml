@model Projet_mvc.Models.User.EditUserViewModel
@{
    ViewData["Title"] = "Modifier mon profil";
}

<div class="row justify-content-center align-items-center form-container form-custom-base">
    <div class="col-md-6 form-card">
        <h2 class="form-custom-base__title">Modifier mon profil</h2>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Nom d'utilisateur" />
                <label for="Username">Nom d'utilisateur</label>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <label for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nouveau mot de passe" />
                <label for="NewPassword">Nouveau mot de passe</label>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirmer le mot de passe" />
                <label for="ConfirmPassword">Confirmer le mot de passe</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="mt-5 d-flex justify-content-between gap-3">
                <a asp-controller="Home" asp-action="Index" class="form-cancel-btn">Annuler</a>
                <button type="submit" class="form-submit-btn">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
