@model Projet_mvc.Models.User.UserViewModel

@{
    ViewData["Title"] = "Mon Profil";
}


<div class="form-custom-base section-spacing">
    <div class="container form-container d-flex justify-content-center align-items-start">
        <div class="form-card col-md-8 col-lg-6">
            <h2>Mon Profil</h2>

            <div class="card p-3 shadow-sm">
                <p><strong>Nom d'utilisateur :</strong> @Model.Username</p>
                <p><strong>Email :</strong> @Model.Email</p>
                <p><strong>Rôle :</strong> @Model.Role</p>
                <p><strong>Inscrit le :</strong> @Model.Creation_Date.ToString("dd/MM/yyyy")</p>
            </div>

            <div class="submit-btn-container d-flex flex-column gap-2">
                <a asp-action="Edit" class="btn btn-primary">Modifier mes informations</a>

                <!-- Bouton pour ouvrir le modal -->
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">Supprimer mon compte</button>
            </div>
	    </div>
    </div>

    <!-- Modal de confirmation de suppression -->
    <div class="modal fade" id="deleteAccountModal" tabindex="-1" role="dialog" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteAccountModalLabel">Confirmation de suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer définitivement votre compte ? Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form asp-action="DeleteAccount" method="post">
                        <button type="submit" class="btn btn-danger">Supprimer mon compte</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="form-custom-base section-spacing">
    <div class="container form-container d-flex justify-content-center align-items-start">
        <div class="form-card col-md-8 col-lg-6">
            <h2>Mes annonces</h2>

            @if (Model.Listings.Any())
            {
                <ul class="list-group">
                    @foreach (var listing in Model.Listings)
                    {
                        <li class="list-group-item">
                            <strong>@listing.Title</strong><br />
                            @listing.Price € - @listing.CreationDate.ToString("dd/MM/yyyy")<br />
                            <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">Voir</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>Vous n'avez publié aucune annonce.</p>
            }
        </div>
	</div>
</div>

<div class="form-custom-base section-spacing">
    <div class="container form-container d-flex justify-content-center align-items-start">
        <div class="form-card col-md-8 col-lg-6">
            <h2>Mes favoris</h2>
            @if (Model.FavoriteListings.Any())
            {
                <ul class="list-group">
                    @foreach (var listing in Model.FavoriteListings)
                    {
                        <li class="list-group-item">
                            <strong>@listing.Title</strong><br />
                            @listing.Price € - @listing.CreationDate.ToString("dd/MM/yyyy")<br />
                            <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">Voir</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>Vous n'avez aucun favoris.</p>
            }
        </div>
	</div>
</div>
