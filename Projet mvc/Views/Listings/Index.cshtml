@using Projet_mvc.Models.Listing;

@model ListingIndexViewModel
@{
    ViewData["Title"] = "Perles Rétro à Collectionner";
}

<div class="container my-5">
    <div class="page-hero-section">
        <div class="container-fluid py-2">
            <h2>Explorez nos annonces rétro uniques</h2>
            <p>Explorez notre vaste catalogue d'annonces uniques.</p>
        </div>
    </div>
    <hr class="my-5">

    <div class="row g-4">
        <div class="col-md-4 col-lg-3 sticky-filter-sidebar">
            <div class="filter-card h-100">
                <div class="card-body p-3">
                    <h6 class="card-title mb-3 text-primary"><i class="bi bi-funnel me-2"></i>Affiner la recherche</h6>
                    <form asp-controller="Listings" asp-action="Index" method="get" class="row g-3">
                        <div class="col-12 mb-2">
                            <label asp-for="Filter.SearchTerm" class="form-label visually-hidden">Rechercher</label>
                            <div class="input-group">
                                <input asp-for="Filter.SearchTerm" class="form-control" placeholder="Rechercher..." />
                                <button type="submit" class="btn btn-outline-primary" title="Rechercher"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="col-12 mb-2">
                            <label class="form-label visually-hidden">Prix</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-currency-euro"></i></span>
                                <input asp-for="Filter.MinPrice" type="number" step="0.01" class="form-control" placeholder="Min" aria-label="Prix Minimum" />
                                <input asp-for="Filter.MaxPrice" type="number" step="0.01" class="form-control" placeholder="Max" aria-label="Prix Maximum" />
                            </div>
                            <span asp-validation-for="Filter.MinPrice" class="text-danger d-block mt-1"></span>
                            <span asp-validation-for="Filter.MaxPrice" class="text-danger d-block"></span>
                        </div>


                        <div class="col-12 mb-2">
                            @if (Model.Filter.AvailableTags != null && Model.Filter.AvailableTags.Any())
                            {
                                <div class="tags-scroll-area">
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var tag in Model.Filter.AvailableTags)
                                        {
                                            <input type="checkbox" class="btn-check" autocomplete="off"
                                                   value="@tag.Value" id="tag_@tag.Value" name="Filter.SelectedTagIds" checked="@tag.Selected">
                                            <label class="btn btn-outline-primary btn-sm rounded-pill" for="tag_@tag.Value">@tag.Text</label>
                                        }
                                    </div>
                                </div>
                                <span asp-validation-for="Filter.SelectedTagIds" class="text-danger d-block mt-2"></span>
                            }
                            else
                            {
                                <p class="text-muted small">Aucun tag disponible.</p>
                            }
                        </div>

                        <div class="col-12 d-flex justify-content-between mt-2">
                            <a asp-controller="Listings" asp-action="Index" class="btn btn-outline-secondary flex-grow-1 me-2">Réinitialiser</a>
                            <button type="submit" class="btn btn-primary flex-grow-1">Appliquer</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9">
            <div class="d-flex justify-content-end align-items-center mb-4">
                <form asp-controller="Listings" asp-action="Index" method="get" class="sort-form d-flex align-items-center">
                    <label asp-for="Filter.SortOrder" class="form-label mb-0 me-2 text-nowrap">Trier par :</label>
                    <select asp-for="Filter.SortOrder" class="form-select w-auto">
                        <option value="date_desc" selected="@(Model.Filter?.SortOrder == "date_desc" || string.IsNullOrEmpty(Model.Filter?.SortOrder))">Plus Récent</option>
                        <option value="date_asc" selected="@(Model.Filter?.SortOrder == "date_asc")">Plus Ancien</option>
                        <option value="price_asc" selected="@(Model.Filter?.SortOrder == "price_asc")">Prix Croissant</option>
                        <option value="price_desc" selected="@(Model.Filter?.SortOrder == "price_desc")">Prix Décroissant</option>
                        <option value="popular" selected="@(Model.Filter?.SortOrder == "popular")">Populaire</option>
                    </select>
                    <input type="hidden" asp-for="Filter.SearchTerm" />
                    <input type="hidden" asp-for="Filter.MinPrice" />
                    <input type="hidden" asp-for="Filter.MaxPrice" />
                    @if (Model.Filter.SelectedTagIds != null)
                    {
                        @foreach (var tagId in Model.Filter.SelectedTagIds)
                        {
                            <input type="hidden" name="Filter.SelectedTagIds" value="@tagId" />
                        }
                    }
                </form>
            </div>

            @if (Model.Listings != null && Model.Listings.Any())
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var listing in Model.Listings)
                    {
                        <div class="col d-flex align-items-stretch">
                            <div class="card listing-card h-100 position-relative">
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.ListingId" class="text-decoration-none">
                                    <img src="@listing.PrimaryImageUrl" class="card-img-top" alt="@listing.PrimaryImageAlt" style="height: 200px; object-fit: cover;">
                                </a>
                                <div class="card-body d-flex flex-column position-relative">
                                    <h5 class="card-title mb-2">
                                        <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.ListingId" class="text-decoration-none text-dark">
                                            @listing.Title
                                        </a>
                                    </h5>
                                    <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                        <span class="card-text fs-4 fw-bold text-primary">@listing.Price.ToString("C")</span>                                        
                                        @await Html.PartialAsync("_FavoriteButton", listing)                                       
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="alert alert-info" role="alert">
                        <h4 class="alert-heading"><i class="bi bi-info-circle me-2"></i>Aucun résultat trouvé !</h4>
                        <p>Il semble qu'il n'y ait aucune annonce correspondant à vos critères de recherche.</p>
                        <hr>
                        <p class="mb-0">Essayez de modifier vos filtres ou de les réinitialiser.</p>
                    </div>
                </div>
            }

            @if (User.IsInRole("Admin"))
            {
                <div class="card admin-tag-card mt-5 mb-3">
                    <div class="card-body">
                        <h6 class="card-title mb-3 text-success"><i class="bi bi-tag-fill me-2"></i>Ajouter un Nouveau Tag</h6>
                        <form asp-controller="Tags" asp-action="Create" method="post">
                            <div class="input-group">
                                <input type="text" name="Label" class="form-control" placeholder="Nouveau tag" required />
                                <button class="btn btn-success" type="submit" title="Créer le tag"><i class="bi bi-plus-circle-fill"></i></button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/listings-index.js"></script>
}