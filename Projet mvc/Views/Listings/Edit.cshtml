@model Projet_mvc.Models.Listing.ListingFormViewModel

<div class="row justify-content-center align-items-center form-container form-custom-base">
    <div class="col-md-6 form-card">
        <h2 class="text-center">Modifier cette annonce</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="form-custom-base">

            <partial name="_ListingForm" model="Model" />

            @if (Model.ExistingImages != null && Model.ExistingImages.Any())
            {
                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted h6 mb-3 mt-2">Images actuelles (cochez pour supprimer)</label>

                    <div class="image-checkbox-container">
                        @foreach (var image in Model.ExistingImages)
                        {
                            <div class="image-checkbox-item">
                                <input type="checkbox" class="btn-check visually-hidden" name="ToDeleteImageIds" value="@image.ImageId" id="delete_img_@image.ImageId" autocomplete="off" />
                                <label for="delete_img_@image.ImageId">
                                    <img src="@image.FilePath" alt="@image.AltText" />
                                    <span class="delete-icon-overlay">
                                        <i class="fa-solid fa-trash"></i>
                                    </span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="form-group">
                <label asp-for="Images" class="form-label fw-semibold text-muted h6 mb-3 mt-2">Ajouter de nouvelles images</label>
                <input asp-for="Images" type="file" class="form-control" multiple />
                <span asp-validation-for="Images" class="text-danger"></span>
            </div>

            <div class="mt-5 d-flex justify-content-between gap-3">
                <a asp-controller="Home" asp-action="Index" class="form-cancel-btn">Annuler</a>
                <button type="submit" class="form-submit-btn">Modifier l'annonce</button>
            </div>
        </form>
    </div>
   
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}